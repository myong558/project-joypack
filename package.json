{
  "name": "joypack",
  "private": true,
  "version": "1.35.0",
  "author": "Myong Bum Soo",
  "license": "UNLICENSED",
  "description": "조이팩: 미니 게임 모음 웹앱",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "bump": "node scripts/bump.mjs",
    "dev": "pnpm --filter hub dev",
    "test": "pnpm -r --if-present test",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/preview.mjs",
    "check:screens": "node scripts/screen-check/run.mjs",
    "release": "node scripts/release.mjs",
    "setup:claude": "node scripts/setup-claude.mjs",
    "font": "pnpm -r --filter ./apps/** --filter ./games/** font"
  },
  "devDependencies": {
    "subset-font": "^2.9.0"
  }
}
