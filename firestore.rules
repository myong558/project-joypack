// =====================================================================================================
// 조이팩 Firestore 보안 규칙 원본 (Firebase 프로젝트 joypack-c6bd2)
// 고친 뒤 Firebase 콘솔 → Firestore Database → 규칙 에 그대로 붙여 넣고 게시한다.
//
// 게임마다 games/<게임ID>/ 아래만 열어 두고, 나머지 경로는 모두 막힌다(규칙이 없는 경로는 거부).
// 새 게임을 추가하면 맨 아래에 "■ 게임: ..." 구역을 하나 더 만든다.
//
// 목차
//   ■ 공통        allowedName(랭킹 이름 검사)
//   ■ 업다운      games/updown/scores-{50|100|200}/{id}   기록 1건 = 문서 1개
//   ■ 두더지잡기  games/hammer/rankings/{classic|daily-YYYY-MM-DD}   순위표 1개 = 문서 1개
//   ■ 타임 투 플립 games/timetoflip/rankings/{classic|daily-YYYY-MM-DD}   순위표 1개 = 문서 1개
//   ■ 온실정원   games/glasshouse/rankings/{garden|daily-YYYY-MM-DD}   순위표 1개 = 문서 1개(이름마다 한 줄)
// =====================================================================================================
rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // -------------------------------------------------------------------------------------------------
    // ■ 공통
    // -------------------------------------------------------------------------------------------------

    // 랭킹 이름: 영문 대문자 1~5자이고 금지어가 아님.
    // 게임 안의 Joypack.isAllowedName(packages/shared/joypack.js)과 같은 목록을 서버에서도 검사한다
    // (앱을 거치지 않고 직접 보내는 요청 대비). 목록을 고치면 두 곳을 같이 고친다.
    function allowedName(n) {
      return n is string
        && n.matches('^[A-Z]{1,5}$')
        // 이름 전체가 이 낱말이면 금지
        && !(n in ['ASS', 'ARSE', 'CUM', 'FAG', 'SEX', 'SEXY', 'TIT', 'TITS', 'ANAL', 'ANUS', 'HOMO', 'GAY', 'JAP',
                   'SIBA', 'SSIB', 'BYUNG', 'GSAEK', 'SEKI', 'SAEKI', 'SEKKI'])
        // 이름 어디에든 이 낱말이 들어 있으면 금지
        && !n.matches('.*(FUCK|FUK|FCK|SHIT|CUNT|COCK|DICK|PUSSY|BITCH|BICH|SLUT|WHORE|PENIS|VAGIN|NIGG|NIGA|FAGG|RAPE|PORN|NAZI|HITLR|HITLE|KKK|BOOB|DILDO|JIZZ|TWAT|WANK|SIBAL|SSIBA|SHIBA|SIBBA|JOTGA|JOTKA|BYUNS|GAESE|GESEK|GAESA|JIRAL|JIRAR|NIGMI|NIMIR|BOJI|JAJI).*');
    }

    // -------------------------------------------------------------------------------------------------
    // ■ 게임: 업다운 (updown)
    //   경로   games/updown/scores-50 · scores-100 · scores-200 / {자동 ID}
    //   모양   기록 1건 = 문서 1개 { initials, score, tries, time, thermo, createdAt }
    //          thermo: 온도계를 쓴 판이면 true(업다운 v1.15.0~, 랭킹에 🌡️). 그 전 기록·예전 버전 화면이 올린 기록에는 없다(= 안 씀)
    //   권한   누구나 읽기·등록만. 고치기·지우기 금지
    //   점수   games/updown/js/game.js 의 score() 와 같은 식으로 상한을 검사한다(0점은 항상 허용)
    //          1000 + 100 × (정석 횟수 − 시도 횟수) − (걸린 시간 ms ÷ 100, 버림) − 온도계 차감
    //          온도계 차감: thermo 가 true 면 50: 250, 100·200: 300 (game.js 의 thermoCost 와 같게)
    //          정석 횟수 = ⌈log2(끝 숫자 + 1)⌉ → 50: 6, 100: 7, 200: 8
    //   참고   예전 하트·난이도 방식 기록(games/updown/scores)은 규칙이 없어 읽기·쓰기 모두 막힌다
    // -------------------------------------------------------------------------------------------------
    match /games/updown/{board}/{id} {
      function updownBoard() {
        return board in ['scores-50', 'scores-100', 'scores-200'];
      }
      function updownScore(d) {
        return d.score is int
          && d.score >= 0
          && (d.score == 0
            || d.score <= 1000
              + 100 * ({'scores-50': 6, 'scores-100': 7, 'scores-200': 8}[board] - d.tries)
              - math.floor(d.time / 100)
              - updownThermoCost(d));
      }
      // 온도계를 쓴 판의 차감 점수(thermo 가 없으면 안 쓴 것으로 본다)
      function updownThermoCost(d) {
        return d.get('thermo', false) == true ? {'scores-50': 250, 'scores-100': 300, 'scores-200': 300}[board] : 0;
      }

      allow read: if updownBoard();
      allow create: if updownBoard()
        && request.resource.data.keys().hasOnly(['initials', 'score', 'tries', 'time', 'thermo', 'createdAt'])
        && request.resource.data.get('thermo', false) is bool
        && allowedName(request.resource.data.initials)
        && request.resource.data.tries is int
        && request.resource.data.tries >= 1
        && request.resource.data.tries <= {'scores-50': 50, 'scores-100': 100, 'scores-200': 200}[board]
        && request.resource.data.time is int
        && request.resource.data.time >= 0
        && request.resource.data.time <= 86400000
        && updownScore(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // -------------------------------------------------------------------------------------------------
    // ■ 게임: 두더지잡기 (hammer)
    //   경로   games/hammer/rankings/classic · daily-YYYY-MM-DD
    //   모양   순위표 1개 = 문서 1개 { entries: [{ name, score, date }, ...] } (점수 높은 순 1~10위)
    //   권한   누구나 읽기. 등록은 트랜잭션으로 문서 전체를 다시 쓰므로 "기존 순위표에 새 기록 1개를 끼운 것"만 받는다
    //          - 새 기록은 정확히 1개: 이름 금지어 검사, 점수 1~20000(정상 최고 기록은 약 2,600점),
    //            날짜 형식(오늘의 챌린지는 문서 날짜와 같아야 함)
    //          - 기존 기록은 지우거나 바꿀 수 없다. 10위가 꽉 찼을 때만 11위로 밀린 꼴찌 1개가 빠지고,
    //            새 기록은 그 꼴찌보다 높아야 한다
    //          - 목록은 항상 점수 높은 순. 문서 지우기 금지
    //   한계   점수 자체를 부풀리는 것(20000점 이하)은 서버에서 게임을 다시 돌려 보지 않는 한 막을 수 없으니,
    //          그런 기록은 Firebase 콘솔에서 사람이 지운다
    // -------------------------------------------------------------------------------------------------
    match /games/hammer/rankings/{board} {
      function hammerBoard() {
        return board == 'classic' || board.matches('^daily-[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      }
      // 순위표 한 줄
      function hammerEntry(e) {
        return e is map
          && e.keys().hasOnly(['name', 'score', 'date'])
          && allowedName(e.name)
          && e.score is int && e.score >= 1 && e.score <= 20000
          && e.date is string && e.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && (board == 'classic' || board == 'daily-' + e.date);
      }
      // 점수 높은 순인지(규칙에는 반복문이 없어 10칸을 하나씩 비교한다)
      function hammerSorted(e) {
        return (e.size() < 2 || e[0].score >= e[1].score)
          && (e.size() < 3 || e[1].score >= e[2].score)
          && (e.size() < 4 || e[2].score >= e[3].score)
          && (e.size() < 5 || e[3].score >= e[4].score)
          && (e.size() < 6 || e[4].score >= e[5].score)
          && (e.size() < 7 || e[5].score >= e[6].score)
          && (e.size() < 8 || e[6].score >= e[7].score)
          && (e.size() < 9 || e[7].score >= e[8].score)
          && (e.size() < 10 || e[8].score >= e[9].score);
      }
      // old 순위표에 새 기록 1개를 끼운 것이 next 인지
      function hammerInsert(old, next) {
        let added = next.removeAll(old);
        let dropped = old.removeAll(next);
        return next.size() == (old.size() < 10 ? old.size() + 1 : 10)
          && added.size() == 1
          && hammerEntry(added[0])
          && hammerSorted(next)
          && (old.size() < 10
            ? dropped.size() == 0
            : added[0].score > old[9].score && (dropped.size() == 0 || (dropped.size() == 1 && dropped[0] == old[9])));
      }

      allow read: if true;
      allow create: if hammerBoard()
        && request.resource.data.keys().hasOnly(['entries'])
        && request.resource.data.entries is list
        && request.resource.data.entries.size() == 1
        && hammerEntry(request.resource.data.entries[0]);
      allow update: if hammerBoard()
        && request.resource.data.keys().hasOnly(['entries'])
        && request.resource.data.entries is list
        && resource.data.entries is list
        && hammerInsert(resource.data.entries, request.resource.data.entries);
      allow delete: if false;
    }

    // -------------------------------------------------------------------------------------------------
    // ■ 게임: 타임 투 플립 (timetoflip)
    //   경로   games/timetoflip/rankings/classic · daily-YYYY-MM-DD
    //   모양   순위표 1개 = 문서 1개 { entries: [{ name, score, stage, date }, ...] } (점수 높은 순 1~10위)
    //   권한   두더지잡기와 같다: 누구나 읽기, 등록은 "기존 순위표에 새 기록 1개를 끼운 것"만, 지우기 금지
    //   점수   stage(도달한 판) 1~99. 점수는 1 이상, 판 수로 정한 상한 이하:
    //          판마다 짝 15쌍 × (100점 × 콤보 5배 + 기억 보너스 50) + 황금 1쌍 2배 + 판 보너스(판 × 200 + 퍼펙트 500)
    //          → stage × 9300 + 100 × stage × (stage + 1) (games/timetoflip/src/game/stages.ts 를 바꾸면 같이 고친다)
    //   공개   공개 시각(games.json open, 2026-10-26 12:00 한국 시각 = 03:00 UTC) 전에는 등록 금지.
    //          서버 시각(request.time)으로 보므로 기기 시계를 바꿔도 공개 전 점수를 올릴 수 없다(개발자 모드 테스트 등록도 막힘).
    //          공개 예약을 바꾸면 ttfOpen() 의 날짜도 같이 고치고 콘솔에 다시 게시한다(기준서 7.4)
    // -------------------------------------------------------------------------------------------------
    match /games/timetoflip/rankings/{board} {
      function ttfOpen() {
        return request.time >= timestamp.date(2026, 10, 26) + duration.value(3, 'h');
      }
      function ttfBoard() {
        return board == 'classic' || board.matches('^daily-[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      }
      function ttfEntry(e) {
        return e is map
          && e.keys().hasOnly(['name', 'score', 'stage', 'date'])
          && allowedName(e.name)
          && e.stage is int && e.stage >= 1 && e.stage <= 99
          && e.score is int && e.score >= 1 && e.score <= e.stage * 9300 + 100 * e.stage * (e.stage + 1)
          && e.date is string && e.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && (board == 'classic' || board == 'daily-' + e.date);
      }
      function ttfSorted(e) {
        return (e.size() < 2 || e[0].score >= e[1].score)
          && (e.size() < 3 || e[1].score >= e[2].score)
          && (e.size() < 4 || e[2].score >= e[3].score)
          && (e.size() < 5 || e[3].score >= e[4].score)
          && (e.size() < 6 || e[4].score >= e[5].score)
          && (e.size() < 7 || e[5].score >= e[6].score)
          && (e.size() < 8 || e[6].score >= e[7].score)
          && (e.size() < 9 || e[7].score >= e[8].score)
          && (e.size() < 10 || e[8].score >= e[9].score);
      }
      function ttfInsert(old, next) {
        let added = next.removeAll(old);
        let dropped = old.removeAll(next);
        return next.size() == (old.size() < 10 ? old.size() + 1 : 10)
          && added.size() == 1
          && ttfEntry(added[0])
          && ttfSorted(next)
          && (old.size() < 10
            ? dropped.size() == 0
            : added[0].score > old[9].score && (dropped.size() == 0 || (dropped.size() == 1 && dropped[0] == old[9])));
      }

      allow read: if true;
      allow create: if ttfOpen()
        && ttfBoard()
        && request.resource.data.keys().hasOnly(['entries'])
        && request.resource.data.entries is list
        && request.resource.data.entries.size() == 1
        && ttfEntry(request.resource.data.entries[0]);
      allow update: if ttfOpen()
        && ttfBoard()
        && request.resource.data.keys().hasOnly(['entries'])
        && request.resource.data.entries is list
        && resource.data.entries is list
        && ttfInsert(resource.data.entries, request.resource.data.entries);
      allow delete: if false;
    }
    // -------------------------------------------------------------------------------------------------
    // ■ 게임: 온실정원 (glasshouse)
    //   경로   games/glasshouse/rankings/garden (정원 점수) · daily-YYYY-MM-DD (오늘의 정원, 아래 ghDaily…)
    //   모양   순위표 1개 = 문서 1개 { entries: [{ name, score, flowers, date }, ...] } (점수 높은 순 1~10위)
    //   권한   누구나 읽기. 등록은 "새 기록 1개를 끼운 것"만: 빈자리에 더하기 · 10위를 밀어내기 ·
    //          같은 이름의 예전(더 낮은) 줄을 바꾸기(정원 점수는 판을 깰수록 오르는 누적 점수라 한 사람이 여러 줄을 차지하지 않게). 지우기 금지
    //   점수   flowers(깬 판) 1~24. 판 점수는 100~1000 의 10점 단위라 정원 점수는 10의 배수이고 flowers × 100 이상 flowers × 1000 이하
    //          (games/glasshouse/src/game/engine.ts levelScore 를 바꾸면 같이 고친다)
    // -------------------------------------------------------------------------------------------------
    match /games/glasshouse/rankings/{board} {
      function ghEntry(e) {
        return e is map
          && e.keys().hasOnly(['name', 'score', 'flowers', 'date'])
          && allowedName(e.name)
          && e.flowers is int && e.flowers >= 1 && e.flowers <= 24
          && e.score is int && e.score % 10 == 0 && e.score >= e.flowers * 100 && e.score <= e.flowers * 1000
          && e.date is string && e.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      }
      function ghSorted(e) {
        return (e.size() < 2 || e[0].score >= e[1].score)
          && (e.size() < 3 || e[1].score >= e[2].score)
          && (e.size() < 4 || e[2].score >= e[3].score)
          && (e.size() < 5 || e[3].score >= e[4].score)
          && (e.size() < 6 || e[4].score >= e[5].score)
          && (e.size() < 7 || e[5].score >= e[6].score)
          && (e.size() < 8 || e[6].score >= e[7].score)
          && (e.size() < 9 || e[7].score >= e[8].score)
          && (e.size() < 10 || e[8].score >= e[9].score);
      }
      function ghInsert(old, next) {
        let added = next.removeAll(old);
        let dropped = old.removeAll(next);
        return added.size() == 1
          && ghEntry(added[0])
          && ghSorted(next)
          && next.size() <= 10
          && ((dropped.size() == 0 && old.size() < 10 && next.size() == old.size() + 1)
            || (dropped.size() == 1 && next.size() == old.size()
              && ((dropped[0].name == added[0].name && dropped[0].score < added[0].score)
                || (old.size() == 10 && dropped[0] == old[9] && added[0].score > old[9].score))));
      }

      // 오늘의 정원(daily-YYYY-MM-DD): { entries: [{ name, moves, time, date }, ...] } 이동 수 적은 순, 같으면 시간(ms) 짧은 순.
      // 판은 날마다 정해져 있어(games/glasshouse/src/game/daily-data.ts) 이동 수 1~999, 시간 1초~하루, 날짜는 문서 날짜와 같아야 한다.
      // 등록 방식은 정원 점수와 같다(이름마다 가장 좋은 한 줄)
      function ghDailyBoard() {
        return board.matches('^daily-[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      }
      function ghDailyEntry(e) {
        return e is map
          && e.keys().hasOnly(['name', 'moves', 'time', 'date'])
          && allowedName(e.name)
          && e.moves is int && e.moves >= 1 && e.moves <= 999
          && e.time is int && e.time >= 1000 && e.time <= 86400000
          && e.date is string && board == 'daily-' + e.date;
      }
      // a 가 b 보다 앞서는지(같으면 먼저 올린 b 가 앞)
      function ghAhead(a, b) {
        return a.moves < b.moves || (a.moves == b.moves && a.time < b.time);
      }
      function ghDailySorted(e) {
        return (e.size() < 2 || !ghAhead(e[1], e[0]))
          && (e.size() < 3 || !ghAhead(e[2], e[1]))
          && (e.size() < 4 || !ghAhead(e[3], e[2]))
          && (e.size() < 5 || !ghAhead(e[4], e[3]))
          && (e.size() < 6 || !ghAhead(e[5], e[4]))
          && (e.size() < 7 || !ghAhead(e[6], e[5]))
          && (e.size() < 8 || !ghAhead(e[7], e[6]))
          && (e.size() < 9 || !ghAhead(e[8], e[7]))
          && (e.size() < 10 || !ghAhead(e[9], e[8]));
      }
      function ghDailyInsert(old, next) {
        let added = next.removeAll(old);
        let dropped = old.removeAll(next);
        return added.size() == 1
          && ghDailyEntry(added[0])
          && ghDailySorted(next)
          && next.size() <= 10
          && ((dropped.size() == 0 && old.size() < 10 && next.size() == old.size() + 1)
            || (dropped.size() == 1 && next.size() == old.size()
              && ((dropped[0].name == added[0].name && ghAhead(added[0], dropped[0]))
                || (old.size() == 10 && dropped[0] == old[9] && ghAhead(added[0], old[9])))));
      }

      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['entries'])
        && request.resource.data.entries is list
        && request.resource.data.entries.size() == 1
        && ((board == 'garden' && ghEntry(request.resource.data.entries[0]))
          || (ghDailyBoard() && ghDailyEntry(request.resource.data.entries[0])));
      allow update: if request.resource.data.keys().hasOnly(['entries'])
        && request.resource.data.entries is list
        && resource.data.entries is list
        && ((board == 'garden' && ghInsert(resource.data.entries, request.resource.data.entries))
          || (ghDailyBoard() && ghDailyInsert(resource.data.entries, request.resource.data.entries)));
      allow delete: if false;
    }
  }
}
